# ─── Базовое ────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tverdyy-znak.ru,www.tverdyy-znak.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://tverdyy-znak.ru,https://www.tverdyy-znak.ru

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# POSTGRES_* читает контейнер базы, DATABASE_URL — приложение.
# Пароль должен совпадать в обеих строках.
POSTGRES_DB=tverdyy_znak
POSTGRES_USER=tz
POSTGRES_PASSWORD=
DATABASE_URL=postgres://tz:ЗАМЕНИТЬ_НА_POSTGRES_PASSWORD@db:5432/tverdyy_znak

# ─── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Шифрование полей с персональными данными (ТЗ 8.1) ──────────────────────
# Сгенерировать: python manage.py generate_fernet_key
# Первый ключ — активный, остальные нужны только для расшифровки старых
# записей. Ключ не должен лежать в том же месте, что и бэкапы.
FIELD_ENCRYPTION_KEYS=

# ─── Организация по умолчанию (мультиарендность, ТЗ 3.1) ────────────────────
DEFAULT_ORGANIZATION_SLUG=tverdyy-znak

# ─── Второй фактор (ТЗ 8.2) ─────────────────────────────────────────────────
# Владелец и администратор входят по паролю + коду из приложения.
# False допустимо ТОЛЬКО на время приёмки, пока в базе нет данных учеников.
# Если устройство потеряно — не выключайте фактор целиком, а сбросьте его
# одному человеку: docker compose exec web python manage.py reset_two_factor <email>
TWO_FACTOR_ENABLED=True

# ─── Telegram: куда падают заявки (ТЗ 7) ────────────────────────────────────
# Токен у @BotFather. chat_id личного чата — у @userinfobot,
# для группы — добавить бота в группу и открыть
# https://api.telegram.org/bot<ТОКЕН>/getUpdates
TG_BOT_TOKEN=
TG_CHAT_ID=

# ─── Почта ──────────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@tverdyy-znak.ru

# ─── Мониторинг ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ─── Аналитика (только публичная часть, ТЗ 7) ───────────────────────────────
YANDEX_METRIKA_ID=

# ─── Бэкапы ─────────────────────────────────────────────────────────────────
# Публичный ключ age; приватный хранить НЕ на этом сервере.
BACKUP_AGE_RECIPIENT=
# Куда выгружать копию: rclone-remote или user@host:/path
BACKUP_REMOTE_TARGET=
BACKUP_HOUR_UTC=20
