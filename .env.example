# ─── Базовое ────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-with-manage.py-generate_secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://tverdyy-znak.ru,https://www.tverdyy-znak.ru

# ─── База данных ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://tz:tz@127.0.0.1:5432/tverdyy_znak

# ─── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ─── Шифрование полей с персональными данными (ТЗ 8.1) ──────────────────────
# Сгенерировать: python manage.py generate_fernet_key
# Первый ключ — активный, остальные нужны только для расшифровки старых записей.
FIELD_ENCRYPTION_KEYS=

# ─── Организация по умолчанию (мультиарендность, ТЗ 3.1) ────────────────────
DEFAULT_ORGANIZATION_SLUG=tverdyy-znak

# ─── Telegram (ТЗ 7) ────────────────────────────────────────────────────────
TG_BOT_TOKEN=
TG_CHAT_ID=

# ─── Почта ──────────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@tverdyy-znak.ru

# ─── Мониторинг ─────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ─── Аналитика (только публичная часть, ТЗ 7) ───────────────────────────────
YANDEX_METRIKA_ID=

# ─── Бэкапы ─────────────────────────────────────────────────────────────────
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE_TARGET=
